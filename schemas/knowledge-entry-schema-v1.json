{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Xx-LiDAF-xX/THANOS/main/schemas/knowledge-entry-schema-v1.json",
  "title": "knowledge-entry",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "gameFamilyId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "issue",
        "fix",
        "compatibility"
      ]
    },
    "summary": {
      "type": "string"
    },
    "executableHashes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "signatureIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "$ref": "common-schema-v1.json#/$defs/Provenance"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "gameFamilyId",
    "kind",
    "summary",
    "executableHashes",
    "signatureIds",
    "provenance"
  ],
  "additionalProperties": false
}
