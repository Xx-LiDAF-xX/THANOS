{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Xx-LiDAF-xX/THANOS/main/schemas/parsed-log-schema-v1.json",
  "title": "parsed-log",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sourcePath": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rawText": {
      "type": "string"
    },
    "kytyVersion": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "titleId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "hardware": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "error-event-schema-v1.json"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "sourcePath",
    "sha256",
    "rawText",
    "kytyVersion",
    "titleId",
    "hardware",
    "events",
    "limitations"
  ],
  "additionalProperties": false
}
