{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Xx-LiDAF-xX/THANOS/main/schemas/analysis-schema-v1.json",
  "title": "analysis",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "game": {
      "$ref": "game-schema-v1.json"
    },
    "kyty": {
      "anyOf": [
        {
          "$ref": "kyty-fingerprint-schema-v1.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "log": {
      "anyOf": [
        {
          "$ref": "parsed-log-schema-v1.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "game",
    "kyty",
    "log",
    "limitations"
  ],
  "additionalProperties": false
}
