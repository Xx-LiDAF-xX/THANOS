<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Thanos.Desktop.ViewModels" x:Class="Thanos.Desktop.MainWindow"
        x:DataType="vm:MainViewModel" Title="THANOS · Compatibility Research" Width="1000" Height="780" MinWidth="640" MinHeight="540">
  <Grid Margin="28" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="12">
    <StackPanel Grid.Row="0" Spacing="6">
      <TextBlock Text="THANOS" FontSize="30" FontWeight="Bold" />
      <TextBlock Text="Kyty compatibility research · Phase 4 validated working-copy transactions" Foreground="#A9B7C9" />
    </StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="140,*,Auto" ColumnSpacing="10">
      <TextBlock Text="Game folder / file" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" Text="{Binding GamePath}" Watermark="Game folder, executable, ZIP, RAR, 7z, ZAR or PKG" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5"><Button Content="Folder" Click="ChooseGameFolder" /><Button Content="File" Click="ChooseGameFile" /></StackPanel>
    </Grid>
    <Grid Grid.Row="2" ColumnDefinitions="140,*,Auto" ColumnSpacing="10">
      <TextBlock Text="Kyty (optional)" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" Text="{Binding KytyPath}" Watermark="Fingerprint installed executable" />
      <Button Grid.Column="2" Content="Browse" Click="ChooseKyty" />
    </Grid>
    <Grid Grid.Row="3" ColumnDefinitions="140,*,Auto" ColumnSpacing="10">
      <TextBlock Text="Log (optional)" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" Text="{Binding LogPath}" Watermark="UTF-8 log or archive; archive.zip!/member for selection" />
      <Button Grid.Column="2" Content="Browse" Click="ChooseLog" />
    </Grid>
    <Grid Grid.Row="4" ColumnDefinitions="140,*,Auto" ColumnSpacing="10">
      <TextBlock Text="Knowledge (optional)" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" Text="{Binding KnowledgePath}" Watermark="Provenanced knowledge JSON" />
      <Button Grid.Column="2" Content="Browse" Click="ChooseKnowledge" />
    </Grid>
    <Grid Grid.Row="5" ColumnDefinitions="140,*,Auto" ColumnSpacing="10">
      <TextBlock Text="Related build (optional)" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" Text="{Binding RelatedPath}" Watermark="Related executable or game archive" />
      <Button Grid.Column="2" Content="Browse" Click="ChooseRelated" />
    </Grid>
    <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="10">
      <Button Content="Analyze" Command="{Binding AnalyzeCommand}" />
      <Button Content="Export JSON" Click="ExportReport" IsEnabled="{Binding HasReport}" />
      <Button Content="Copy JSON" Click="CopyReport" IsEnabled="{Binding HasReport}" />
    </StackPanel>
    <TextBlock Grid.Row="7" Text="{Binding Status}" TextWrapping="Wrap" Foreground="#A9B7C9" />
    <StackPanel Grid.Row="8" Orientation="Horizontal" Spacing="8">
      <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" Width="220" />
      <Button Content="Generate prompt" Command="{Binding GeneratePromptCommand}" />
      <Button Content="Copy prompt" Click="CopyPrompt" IsEnabled="{Binding HasPrompt}" />
      <Button Content="Export prompt" Click="ExportPrompt" IsEnabled="{Binding HasPrompt}" />
      <Button Content="Evidence ZIP" Click="ExportBundle" IsEnabled="{Binding HasPrompt}" />
    </StackPanel>
    <TextBlock Grid.Row="9" Text="{Binding Readiness}" TextWrapping="Wrap" />
    <TabControl Grid.Row="10">
      <TabItem Header="Research JSON"><TextBox Text="{Binding Report}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" /></TabItem>
      <TabItem Header="AI request / missing evidence"><TextBox Text="{Binding PromptText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" /></TabItem>
      <TabItem Header="Patch validation / transaction">
        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8" Margin="8">
          <Grid Grid.Row="0" ColumnDefinitions="120,*,Auto" ColumnSpacing="8">
            <TextBlock Text="Patch / AI output" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding PatchPath}" Watermark="Versioned JSON, Markdown, diff, script or binary patch" />
            <Button Grid.Column="2" Content="Browse" Click="ChoosePatch" />
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="120,*,Auto" ColumnSpacing="8">
            <TextBlock Text="Transaction" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding TransactionPath}" Watermark="New directory for apply; existing directory for inspect/rollback" />
            <Button Grid.Column="2" Content="Choose parent" Click="ChooseTransactionParent" />
          </Grid>
          <WrapPanel Grid.Row="2" Orientation="Horizontal">
            <Button Content="Inspect / normalize" Command="{Binding ImportPatchCommand}" Margin="0,0,8,8" />
            <Button Content="Validate target" Command="{Binding ValidatePatchCommand}" IsEnabled="{Binding HasPatch}" Margin="0,0,8,8" />
            <Button Content="Create working copy…" Click="ApplyPatch" IsEnabled="{Binding HasValidPatch}" Margin="0,0,8,8" />
            <Button Content="Inspect transaction" Command="{Binding InspectTransactionCommand}" Margin="0,0,8,8" />
            <Button Content="Rollback working copy…" Click="RollbackPatch" IsEnabled="{Binding HasTransaction}" Margin="0,0,8,8" />
            <Button Content="Restore original from backup…" Click="RestoreOriginal" IsEnabled="{Binding HasTransaction}" Margin="0,0,8,8" />
          </WrapPanel>
          <TextBox Grid.Row="3" Text="{Binding PatchOutput}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" />
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
